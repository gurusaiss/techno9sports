# Techno9Sports backend. Copy to .env (never commit .env).
DATABASE_URL=postgres://t9:t9dev@localhost:5432/t9   # local Postgres (docker compose or native)
REDIS_URL=redis://localhost:6379                      # events/queues/cache
STORE_CORS=http://localhost:8000                      # storefront origin(s), comma separated
ADMIN_CORS=http://localhost:9000                      # admin origin(s)
AUTH_CORS=http://localhost:9000,http://localhost:8000
JWT_SECRET=change-me-dev-only                         # prod: Key Vault, long random
COOKIE_SECRET=change-me-dev-only                      # prod: Key Vault, long random
AUTH_MFA_ENCRYPTION_KEY=                              # 64 hex chars: openssl rand -hex 32
MEDUSA_ADMIN_ONBOARDING_TYPE=default
# Added in later phases (documented here so nothing is undocumented):
# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET  (Phase 4, test mode only)
# SHIPROCKET_EMAIL / SHIPROCKET_PASSWORD / SHIPROCKET_WEBHOOK_TOKEN (Phase 5)
# MSG91_AUTH_KEY / MSG91_TEMPLATE_IDS  (Phase 3)
# RESEND_API_KEY  (Phase 4)
MEILISEARCH_HOST=http://localhost:7700                  # unset = in-memory local search
MEILISEARCH_API_KEY=t9-dev-master-key
# AZURE_STORAGE_CONNECTION_STRING (Azurite default for local, Phase 2)
