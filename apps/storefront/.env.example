# Techno9Sports storefront environment variables. Copy to .env.local

# URL of the Medusa backend API (e.g. https://api.techno9sports.in or http://localhost:9000)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Canonical public site URL (e.g. https://techno9sports.in or https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:8000

# Medusa publishable API key (from Medusa Admin -> Settings -> Publishable API Keys or seed script)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
MEDUSA_PUBLISHABLE_KEY=

# Shared secret between backend and storefront for cache revalidation (/api/revalidate)
REVALIDATE_SECRET=change-me-dev-only
